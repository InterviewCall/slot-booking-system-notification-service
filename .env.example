# Local development only. In production the settings live on the server in /opt/ic-booking/settings.env
PORT=3000
NODE_ENV=development

REDIS_HOST=localhost
REDIS_PORT=6379
# Production Redis (ElastiCache) needs both:
# REDIS_TLS=true
# REDIS_PASSWORD=

# MySQL. The app reads DB_*; `prisma migrate deploy` reads DATABASE_URL.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=ic_notifications
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/ic_notifications
# Production RDS: encrypt + verify against the AWS CA bundle baked into the image
# DB_SSL=true

# WhatsApp (AiSensy)
AISENSY_API_KEY=
AISENSY_API_URL=

# Email (AWS SES)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET_NAME=

# Notification queue retry policy (defaults shown)
# QUEUE_JOB_ATTEMPTS=5
# QUEUE_RETRY_BACKOFF_MS=30000
# QUEUE_FAILED_RETENTION_DAYS=1
# QUEUE_FAILED_RETENTION_COUNT=5000
